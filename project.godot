[layer_names]

3d_render/layer_20="DEBUG"
3d_physics/layer_1="GENERAL"
3d_physics/layer_2="WORKSPACE"
3d_physics/layer_3="PLACEMENT"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=120
3d/default_gravity=10.0
3d/time_before_sleep=0.25
3d/solver/contact_recycle_radius=0.005
3d/solver/contact_max_allowed_penetration=0.005

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
